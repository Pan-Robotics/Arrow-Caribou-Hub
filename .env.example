# Caribou Hub — local configuration
#
# Every value here is OPTIONAL. With no .env file at all, the Hub runs as a
# self-contained local app: SQLite at ./data/caribou.db, file storage under
# ./data/storage, on http://localhost:3000. Copy this file to ".env" only if
# you need to override a default.

# Port the Hub listens on (default: 3000; auto-bumps if busy).
PORT=3000

# SQLite database file. A bare path, or a "file:" / "sqlite:" URL.
# Default: ./data/caribou.db (created automatically on first run).
# DATABASE_URL=./data/caribou.db

# Directory for uploaded files (flight logs, firmware, drone files, media).
# Default: ./data/storage (created automatically).
# STORAGE_DIR=./data/storage

# Absolute base URL the Hub is reachable at FROM COMPANION COMPUTERS (drones).
# Used to build absolute file URLs embedded in companion jobs (firmware flash,
# file delivery) so the Raspberry Pi can fetch them over the network.
# Leave unset for single-machine use; set to the Hub's LAN IP for benchtop, or to
# the Hub's Tailscale address for fleet deployments (drones reach it over the
# tailnet). See docs/architecture/Tailscale_Network_Architecture.md.
# PUBLIC_BASE_URL=http://192.168.1.50:3000
# PUBLIC_BASE_URL=https://caribou-hub-op1.<tailnet>.ts.net   # via tailscale serve
